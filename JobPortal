    </nav>

    <!-- Home Section -->
    <section id="home" class="section active">
        <div class="container">
            <div class="hero">
                <h1>Find Your Dream Job Today</h1>
                <p>Connect with top companies and explore thousands of job opportunities</p>
                <div class="search-box">
                    <input type="text" placeholder="Job title, keywords, or company">
                    <button>Search Jobs</button>
                </div>
            </div>
            <div class="dashboard-stats">
                <div class="stat-card">
                    <div class="stat-number">5,000+</div>
                    <div class="stat-label">Active Jobs</div>
                </div>
                <div class="stat-card">
                    <div class="stat-number">2,500+</div>
                    <div class="stat-label">Companies</div>
                </div>
                <div class="stat-card">
                    <div class="stat-number">100K+</div>
                    <div class="stat-label">Job Seekers</div>
                </div>
            </div>
        </div>
    </section>

    <!-- About Section -->
    <section id="about" class="section">
        <div class="container">
            <h1>About JobConnect</h1>
            <p style="font-size: 1.2rem; color: #666; margin: 1rem 0 2rem;">Your trusted partner in career growth and job search</p>
            <div class="about-content">
                <div class="about-card">
                    <h3>Our Mission</h3>
                    <p>To connect talented professionals with their dream careers and help companies find the perfect candidates for their teams.</p>
                </div>
                <div class="about-card">
                    <h3>What We Do</h3>
                    <p>We provide a comprehensive platform for job seekers to discover opportunities and for employers to find top talent across all industries.</p>
                </div>
                <div class="about-card">
                    <h3>Why Choose Us</h3>
                    <p>With advanced matching algorithms, verified companies, and personalized job recommendations, we make job searching efficient and effective.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Companies Section -->
    <section id="companies" class="section">
        <div class="container">
            <h1>Top Companies Hiring</h1>
            <p style="font-size: 1.2rem; color: #666; margin: 1rem 0 2rem;">Explore opportunities from leading organizations</p>
            <div class="companies-grid">
                <div class="company-card">
                    <div class="company-logo">T</div>
                    <h3>TechCorp</h3>
                    <p>Technology</p>
                    <p style="color: #667eea; font-weight: bold;">45 Open Positions</p>
                </div>
                <div class="company-card">
                    <div class="company-logo">D</div>
                    <h3>DesignHub</h3>
                    <p>Creative & Design</p>
                    <p style="color: #667eea; font-weight: bold;">32 Open Positions</p>
                </div>
                <div class="company-card">
                    <div class="company-logo">F</div>
                    <h3>FinanceX</h3>
                    <p>Finance & Banking</p>
                    <p style="color: #667eea; font-weight: bold;">28 Open Positions</p>
                </div>
                <div class="company-card">
                    <div class="company-logo">H</div>
                    <h3>HealthPlus</h3>
                    <p>Healthcare</p>
                    <p style="color: #667eea; font-weight: bold;">52 Open Positions</p>
                </div>
                <div class="company-card">
                    <div class="company-logo">E</div>
                    <h3>EduLearn</h3>
                    <p>Education</p>
                    <p style="color: #667eea; font-weight: bold;">19 Open Positions</p>
                </div>
                <div class="company-card">
                    <div class="company-logo">M</div>
                    <h3>MarketPro</h3>
                    <p>Marketing</p>
                    <p style="color: #667eea; font-weight: bold;">36 Open Positions</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Jobs Section -->
    <section id="jobs" class="section">
        <div class="container">
            <h1>Latest Job Openings</h1>
            <p style="font-size: 1.2rem; color: #666; margin: 1rem 0 2rem;">Discover your next career opportunity</p>
            <div class="jobs-grid">
                <div class="job-card">
                    <div class="job-header">
                        <div>
                            <h3 class="job-title">Senior Software Engineer</h3>
                            <p class="job-company">TechCorp</p>
